# 复制为仓库根目录 .env 后供 docker compose / 本地进程读取
# cp .env.example .env

# --- 本地直接跑进程时用 127.0.0.1；compose 内服务会覆盖为 postgres/redis 主机名 ---
DATABASE_URL=postgresql+psycopg2://vr:vr@127.0.0.1:5432/vr
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=change-me-in-env

# 首次启动 API 时若该用户不存在则创建管理员（must_change_password=false）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
XML_CURL_USER=fs
XML_CURL_PASSWORD=change-me

# engine 容器默认 FS_HOST=host.docker.internal；公网 FS 请改成真实 IP/域名
FS_HOST=47.253.82.114
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon

DEFAULT_TENANT=t001
SIP_CRED_TTL_SECONDS=43200
AGENT_WS_TIMEOUT_SECONDS=60
RING_TIMEOUT_SECONDS=20

# 管理台 HTTPS 证书里的 IP。没有域名时浏览器打开 https://这个IP/
PUBLIC_IP=47.253.82.114

# 浏览器软电话。管理台是 HTTPS 时必须用 wss，不能再用 ws://5066
WSS_URL=wss://47.253.82.114:7443

# 管理台上传的放音文件目录（需与 FreeSWITCH 可读路径一致，建议挂到 FS sounds）
VR_SOUND_DIR=/usr/local/freeswitch/sounds/vr
# compose 把宿主机该目录挂进 api 容器时用（与 VR_SOUND_DIR 对应）
VR_SOUND_HOST_DIR=/usr/local/freeswitch/sounds/vr
# 机器人：FreeSWITCH 推流到 ai_gw 的地址（FS 与 docker 同机）
AI_GW_WS_URL=ws://127.0.0.1:8040/fs/stream
# 机器人各厂商密钥，AI 场景里只填变量名
# DEEPSEEK_API_KEY=
# SILICONFLOW_API_KEY=
# 机器人与 IVR 通话在 park 中进行，允许的最长秒数（其他入口仍用 RING_TIMEOUT_SECONDS）
ROBOT_CALL_MAX_SECONDS=1800
